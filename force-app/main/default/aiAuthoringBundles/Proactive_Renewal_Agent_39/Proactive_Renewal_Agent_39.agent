        GetAllCasesForContact:
            description: |
                Returns a list of cases related to a given Contact record.
            label: "Get All Cases For Contact"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "SvcCopilotTmpl__GetAllCasesForContact"
            target: "flow://SvcCopilotTmpl__GetCasesForContact"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            inputs:
                "contactRecord": object
                    description: |
                      The contact record for a customer used to look up related case records.
                    label: "Contact record"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__recordInfoType"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            outputs:
                "caseList": list[object]
                    description: |
                      Stores the ID, Subject, Description, Status, CreatedDate, CaseNumber, LastModifiedDate, and ClosedDate for case records related to a specified contact.
                    label: "Case List"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "lightning__recordInfoType"

        post_on_chatter:
            label: "post on chatter"
            description: "Posts a Chatter notification summarising renewal risk that mentions Account Owner User Id and links the generated email draft."
            target: "apex://postAIGeneratedChatterMessage"
            inputs:
                AccountOwnerId: id
                    label: "AccountOwnerId"
                    description: "Account Owner User Id to mention in the Chatter post."
                    is_required: False
                    complex_data_type_name: "lightning__recordIdType"
                chatterSummary: string
                    label: "chatterSummary"
                    description: "Agent generated summary of renewal risk and recommended actions."
                    is_required: False
                    complex_data_type_name: "lightning__textType"
                contractEndDate: object
                    label: "contractEndDate"
                    description: "Contract End Date associated with the Opportunity."
                    is_required: False
                    complex_data_type_name: "lightning__dateType"
                csatScore: number
                    label: "csatScore"
                    description: "Customer Satisfaction Score associated with the Opportunity."
                    is_required: False
                    complex_data_type_name: "lightning__numberType"
                lastActivityDate: object
                    label: "lastActivityDate"
                    description: "Most recent customer activity date."
                    is_required: False
                    complex_data_type_name: "lightning__dateType"
                mailDraftId: id
                    label: "mailDraftId"
                    description: "EmailMessage Id of the generated draft email. If omitted, the latest draft email related to the Opportunity will be used."
                    is_required: False
                    complex_data_type_name: "lightning__recordIdType"
                openCases: integer
                    label: "openCases"
                    description: "Number of open support cases associated with the Account."
                    is_required: False
                    complex_data_type_name: "lightning__integerType"
                opportunityId: id
                    label: "opportunityId"
                    description: "Opportunity record on which the Chatter notification should be posted."
                    is_required: True
                    complex_data_type_name: "lightning__recordIdType"
                opportunityName: string
                    label: "opportunityName"
                    description: "Opportunity Name for personalization."
                    is_required: False
                    complex_data_type_name: "lightning__textType"
                opportunityStage: string
                    label: "opportunityStage"
                    description: "Current Opportunity Stage."
                    is_required: False
                    complex_data_type_name: "lightning__textType"
            outputs:
                chatterPostId: id
                    label: "chatterPostId"
                    complex_data_type_name: "lightning__recordIdType"
                    is_displayable: False
                    filter_from_agent: False
                linkedEmailDraftId: id
                    label: "linkedEmailDraftId"
                    complex_data_type_name: "lightning__recordIdType"
                    is_displayable: False
                    filter_from_agent: False
                statusMessage: string
                    label: "statusMessage"
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
                summarizedContent: string
                    label: "summarizedContent"
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
            include_in_progress_indicator: True
            progress_indicator_message: "posting on chatter! this might take a while"

subagent Agentforce_Slack_integration:
    label: "Agentforce Slack integration"
    description: "performs operations based on user request via slack. User will Ask the Salesforce related question execute the steps that are required to find necessary details"
    reasoning:
        instructions: ->
            |1. Identify the SObject and record from user input or conversation context. {!@actions.IdentifyObjectByName} {!@actions.IdentifyRecordByName} , ​find the record {!@actions.QueryRecords}.
             2. Retrieve record details using Get Record Details or Summarize Record.  {!@actions.SummarizeRecord} {!@actions.GetRecordDetails} ​
             3. If the user asks about approvals, approval status, approval reminders, approval notifications, pending approvals, or sending approval requests: - Query ProcessInstance for active approval requests associated with the record. - Retrieve the ProcessInstance with Status = 'Pending' {!@actions.QueryRecords} {!@actions.GetRecordDetails} .
             4. Query ProcessInstanceWorkitem using the ProcessInstance.Id {!@actions.QueryRecords}  {!@actions.GetRecordDetails} .
             5. Retrieve: - ProcessInstanceWorkitem.Id, then the Salesforce User using ActorId.{!@actions.QueryRecords}  {!@actions.GetRecordDetails} .
             6. Retrieve the field Slack Member Id from the Salesforce user record to whom the message is to be sent on slack {!@actions.QueryRecords} {!@actions.GetRecordDetails} .
             7. Include the Opportunity Name, Discount Percentage, Requested Price, Current Price, Customer Name, and Approval URL through step 7.3 in the Slack message.
             7.1 Construct the approval URL using ProcessInstanceWorkitem.Id.
             7.2 Validate that the approval URL uses an Id with prefix 04i.
             7.3 Example format:https://orgfarm-7b5b48458e-dev-ed.develop.lightning.force.com/lightning/r/ProcessInstanceWorkitem/{04iXXXXXXXXXXXX}/view
             7.4 If no pending ProcessInstanceWorkitem exists, do not generate an approval URL and instead use the Opportunity URL generated using ProcessInstance.TargetObjectId.
             9. If user doesn't specify where to send message, Ask user if he wants send on slack. then Execute this step. Send the Slack notification to the Slack Member Id, refer step 7 to get this slack member Id. Use {!@actions.SendSlackDirectMessage} . ​Include all the details provided. Always ask the user if he wants to approve it for him. if User responds yes only then move to the step 9.1
             9.1 when the user confirms to approve the Approval Request use this action {!@actions.ApprovalRequest_Action} and take in the input as Approve or reject when inside the Action input. also if any comment are present take them.​
             10. Store the approval request context so that subsequent approve or reject actions can be mapped back to the correct Opportunity.
             11. If user wants to send a notification or Message on slack to a user through agent use this  {!@actions.SendMessageAsAgent}
             12. Check if the channel Name does not exists, create a slack channel using {!@actions.CreateSlackChannel} as per user suggestion.
             13. If the Slack Member ID is unavailable, notify the requester that the approver cannot be contacted through Slack because the Slack mapping is missing.
        actions:
            CreateSlackChannel: @actions.CreateSlackChannel
                with channelName = ...
                with teamId = ...
                with isPrivate = ...
            SendSlackDirectMessage: @actions.SendSlackDirectMessage
                with slackUserId = ...
                with message = ...
            SendMessageToSlackChannel: @actions.SendMessageToSlackChannel
                with channelId = ...
                with message = ...
            SendMessageAsAgent: @actions.SendMessageAsAgent
                with userId = ...
                with message = ...
                with recommendedActions = ...
                with aiGenActionItemIdInContextInput = ...
            QueryRecords: @actions.QueryRecords
                with query = ...
                with customizationInstructions = ...
            IdentifyObjectByName: @actions.IdentifyObjectByName
                with objectName = ...
            SummarizeRecord: @actions.SummarizeRecord
                with recordId = ...
            GetRecordDetails: @actions.GetRecordDetails
                with recordId = ...
            IdentifyRecordByName: @actions.IdentifyRecordByName
                with recordName = ...
                with objectApiName = ...
            ApprovalRequest_Action: @actions.ApprovalRequest_Action
                with action = ...
                with comments = ...
                with workItemId = ...




    actions:
        CreateSlackChannel:
            description: |
                Create a Slack Channel.
              Ask the end user for a Channel name, the Team ID (or Workspace ID) to create the Slack Channel in and whether the Channel is public or private, unless these details are already provided.
              Upon successful completion, provide the channel at-mention and url to the user along with a friendly message.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
            label: "Create a Slack Channel"
            require_user_confirmation: True
            include_in_progress_indicator: True
            progress_indicator_message: "Creating a Slack channel..."
            source: "Slack__CreateSlackChannel"
            target: "slack://slackAgentDynamic__CreateChannel"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
            inputs:
                "channelName": string
                    description: |
                      The name of the channel to create. Channel names should lowercased with only letters, numbers, hyphens and underscores.
                    label: "Channel Name"
                    is_required: True
                    is_user_input: True
                "teamId": string
                    description: |
                      The Team ID (or Workspace ID) of the Slack workspace to create the Channel in.
                    label: "Team ID"
                    is_required: True
                    is_user_input: True
                "isPrivate": boolean
                    description: |
                      If true, creates a private Slack channel. Otherwise creates a public channel.
                    label: "Is Private"
                    is_required: True
                    is_user_input: True
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
            outputs:
                "channelId": string
                    description: |
                      The new Slack channel ID.
                    label: "Slack channel ID"
                    is_displayable: False
                    filter_from_agent: False
                "channelUrl": string
                    description: |
                      The new Slack channel URL.
                    label: "Slack channel URL"
                    is_displayable: False
                    filter_from_agent: False

        SendSlackDirectMessage:
            description: |
                Given plain text or markdown text, send a direct message (DM) in Slack with the recipient and sender users in the DM channel.
              You can add sections, include links, references, and any other information you deem relevant.
              Provide the message url to the user along with a friendly message.
              Upon successful completion, provide the user a friendly confirmation with a link to the message (in markdown).
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
            label: "Send a Slack Direct Message"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Sending Slack direct message..."
            source: "Slack__SendSlackDirectMessage"
            target: "standardInvocableAction://slackAgentSendDirectMessage"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
            inputs:
                "slackUserId": string
                    description: |
                      Slack user ID for the person who will receive the direct message.
                    label: "Slack User Id"
                    is_required: True
                    is_user_input: True
                "message": string
                    description: |
                      Plain text or markdown message to be sent to a user.
                    label: "Slack Message Content"
                    is_required: True
                    is_user_input: True
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
            outputs:
                "channelId": string
                    description: |
                      The Slack direct message channel ID for the sent message.
                    label: "Slack Channel Id"
                    is_displayable: False
                    filter_from_agent: False
                "messageUrl": string
                    description: |
                      The Slack direct message URL for the sent message; opens in Slack.
                    label: "Slack Message URL"
                    is_displayable: False
                    filter_from_agent: False
                "messageTs": string
                    description: |
                      The timestamp for when the direct message was sent in Slack.
                    label: "Slack Message Timestamp"
                    is_displayable: False
                    filter_from_agent: False

        SendMessageToSlackChannel:
            description: |
                Sends a message to a public or private Slack Channel.
              Messages may be in plaintext or Markdown format.
              This action is intended for group communication, announcements, or notifications within channels.
              This action should not be used to send direct messages to individuals.
              Upon successful completion, provide the user a friendly confirmation with a link to the message (in markdown).
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
            label: "Send Message to a Slack Channel"
            require_user_confirmation: True
            include_in_progress_indicator: True
            progress_indicator_message: "Sending message..."
            source: "Slack__SendMessageToSlackChannel"
            target: "slack://slackAgentDynamic__SendMessageToSlackChannel"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
            inputs:
                "channelId": string
                    description: |
                      The Slack Channel ID of the Slack Channel to send a message to.
                    label: "Slack Channel ID"
                    is_required: True
                    is_user_input: True
                "message": string
                    description: |
                      Plain text or mrkdwn message to be sent to a user.
                    label: "Slack Message"
                    is_required: True
                    is_user_input: True
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
            outputs:
                "messageUrl": string
                    description: |
                      The Slack message URL for the sent message; opens in Slack.
                    label: "Slack Message URL"
                    is_displayable: False
                    filter_from_agent: False
                "messageTs": string
                    description: |
                      The timestamp for when the message was sent in Slack.
                    label: "Slack Message Timestamp"
                    is_displayable: False
                    filter_from_agent: False

        SendMessageAsAgent:
            description: |
                Use to send notifications or messages to specific Slack users in a direct message from the agent.
              Messages may be sent in plain text or formatted using Markdown.
              This action is intended to send notifications, inform or message specific Slack Users.
              This action cannot be used to send messages to channels.
              Upon successful completion, provide the user a friendly confirmation with a link to the message (in markdown).
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
            label: "Start a Slack conversation with an Agent"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Starting a Slack conversation with an Agent..."
            source: "slack__SendMessageAsAgent"
            target: "slack://slackAgentDynamic__SendMessageAsAgent"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
            inputs:
                "userId": string
                    description: |
                      The Slack User ID of the user to send the message to.
                    label: "Slack User ID"
                    is_required: True
                    is_user_input: True
                "message": string
                    description: |
                      Plain text or markdown message to be sent to a user.
                    label: "Slack Message"
                    is_required: True
                    is_user_input: True
                "recommendedActions": list[object]
                    description: |
                      The list of recommended actions. Each action may include an optional style field set to 'primary' to mark the recommended-first action or 'danger' for a destructive or escalation action; omit for secondary actions.
                    label: "Recommended Actions"
                    is_required: False
                    is_user_input: True
                    complex_data_type_name: "slack_invocable_actions__promptActionButton"
                "aiGenActionItemIdInContextInput": string
                    description: |
                      Populated from $Context.aiGenActionItemIdInContext when present.
                    label: "aiGenActionItemIdInContextInput"
                    is_required: False
                    is_user_input: False
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
            outputs:
                "messageUrl": string
                    description: |
                      The Slack message URL for the sent message; opens in Slack.
                    label: "Slack Message URL"
                    is_displayable: False
                    filter_from_agent: False
                "messageTs": string
                    description: |
                      The timestamp for when the message was sent in Slack.
                    label: "Slack Message Timestamp"
                    is_displayable: False
                    filter_from_agent: False

        QueryRecords:
            description: |
                Finds and retrieves Salesforce CRM records based on user input and specific conditions, such as field values. This action automatically identifies the correct records and object type. e.g. 'Find all open opportunities created in the last 5 days sorted by created date.'
            label: "Query Records"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "EmployeeCopilot__QueryRecords"
            target: "standardInvocableAction://queryRecords"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            inputs:
                "query": string
                    description: |
                      The question or request from the user's input. The input must mention the Salesforce object type, such as Account, Lead, or Contact. Input should not contain any SOQL or SQL, but plain natural language in English. Do not generate SQL or SOQL.
                    label: "query"
                    is_required: True
                    is_user_input: True
                "customizationInstructions": string
                    description: |
                      Custom instructions for the action from the user's input to optimize the query.
                    label: "customizationInstructions"
                    is_required: False
                    is_user_input: False
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            outputs:
                "result": list[object]
                    description: |
                      A list of matching Salesforce CRM records with details about each record.
                    label: "result"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "lightning__recordInfoType"

        IdentifyObjectByName:
            description: |
                Finds the Salesforce object API name by extracting an object name from the user input.
            label: "Identify Object by Name"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "EmployeeCopilot__IdentifyObjectByName"
            target: "standardInvocableAction://identifyObject"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
            inputs:
                "objectName": string
                    description: |
                      Term representing a salesforce object name from which we want to retrieve the matching api names. For instance for the query "list the reports from user Marc", IdentifyObjectByName could be called 2 times, with objectName="reports" and objectName="user".
                    label: "objectName"
                    is_required: True
                    is_user_input: False
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
            outputs:
                "objectApiNames": list[object]
                    description: |
                      A list of the matching API names of Salesforce object types.
                    label: "objectApiNames"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "lightning__textType"

        SummarizeRecord:
            description: |
                Summarizes a single Salesforce CRM record. You must call summarizeRecord only if the user explicitly asks for a summary (e.g: 'Summary', 'Recap', 'Highlights'). This action should be called only when there isn't a more specific summarization action.
            label: "Summarize Record"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Summarizing"
            source: "EmployeeCopilot__SummarizeRecord"
            target: "standardInvocableAction://getRecordSummarizationPrompt"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            inputs:
                "recordId": object
                    description: |
                      The ID of a Salesforce record used to generate the summary.
                    label: "Record ID"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__recordIdType"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            outputs:
                "recordSummary": object
                    description: |
                      The rich text summary generated for the specified record.
                    label: "Record Summary"
                    is_displayable: False
                    filter_from_agent: True
                    complex_data_type_name: "lightning__richTextType"

        GetRecordDetails:
            description: |
                Generates a text blob containing record details, including object fields and values and records from related lists.
            label: "Get Record Details"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Getting details"
            source: "EmployeeCopilot__GetRecordDetails"
            target: "standardInvocableAction://getDataForGrounding"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            inputs:
                "recordId": object
                    description: |
                      The ID of a Salesforce record to get the record details for.
                    label: "Record ID"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__recordIdType"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            outputs:
                "snapshot": string
                    description: |
                      Record details, including object fields and values, records from related lists, and more.
                    label: "Record Details"
                    is_displayable: False
                    filter_from_agent: False

        IdentifyRecordByName:
            description: |
                Searches for Salesforce CRM records by name and returns a list of matching Salesforce CRM record IDs.
            label: "Identify Record by Name"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "EmployeeCopilot__IdentifyRecordByName"
            target: "standardInvocableAction://identifyRecordByName"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            inputs:
                "recordName": string
                    description: |
                      The name or title of the Salesforce record extracted from user input. The name can be used to find a Salesforce CRM record.
                    label: "recordName"
                    is_required: True
                    is_user_input: True
                "objectApiName": string
                    description: |
                      The API name of the Salesforce object (such as Account or Opportunity) associated with the record the user wants to find. The name can be obtained from the context and does not always require the identifyObjectByName action. (eg. IdentifyRecordByName(recordName="Paul", objectApiName="user")). Leave empty to check with all possible objectApiNames. Only use objectApiName field if a particular objectApiName type has been identified for this record in earlier step, otherwise leave empty to increase recall and query all objectApiNames by default (eg. IdentifyRecordByName(recordName="Paul")).
                    label: "objectApiName"
                    is_required: False
                    is_user_input: False
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            outputs:
                "searchResults": list[object]
                    description: |
                      A list of the matching Salesforce record ids in descending order of relevance.
                    label: "searchResults"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "lightning__recordInfoType"

        ApprovalRequest_Action:
            label: "ApprovalRequest Action"
            description: "Approves a pending ProcessInstanceWorkItem (approval request). The action succeeds only if the specified approver has permission to approve the request."
            target: "apex://approveRequestInvocableAction"
            inputs:
                action: string
                    label: "action"
                    description: "This takes the input in text form 'Approve' or 'reject'. as per the User intention take appropriate word here."
                    is_required: True
                    complex_data_type_name: "lightning__textType"
                comments: string
                    label: "comments"
                    description: "If user provide the Reason for approval note it for this input"
                    is_required: False
                    complex_data_type_name: "lightning__textType"
                workItemId: string
                    label: "workItemId"
                    description: "This is the ProcessInstanceWorkItem ID that is being approved"
                    is_required: True
                    complex_data_type_name: "lightning__textType"
            outputs:
                message: string
                    label: "message"
                    description: "The output of the Outcome for Approval Request being made."
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
                newStatus: string
                    label: "newStatus"
                    description: "What status it is ProcessInstanceWorkItem in currently."
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
                success: boolean
                    label: "success"
                    description: "Approval or Disapproval Success Message"
                    complex_data_type_name: "lightning__booleanType"
                    is_displayable: False
                    filter_from_agent: False
            include_in_progress_indicator: False
            progress_indicator_message: ""

subagent Approval_subagent:
    label: "Approval subagent"
    description: |

        This agent is responsible for approving the requests
    reasoning:
        instructions: ->
            |1. Get the Object {!@actions.IdentifyObjectByName}, then Identify the Record {!@actions.IdentifyRecordByName} ​.
             2. Pass the Identified Id to this {!@actions.ProcessInstanceWorkItem_Id_Action}  and get the ProcessinstanceWorkItem. Use the provided ProcessInstance.TargetObjectId where TargetObjectId retrieved in step 1 is the  to find the pending ProcessInstance for that record.
             3. Retrieve the ProcessInstanceWorkItem.Id. Pass the ProcessInstanceWorkItem.Id as the input to the approval action. Use this action {!@actions.ApprovalRequest_Action} and take in the input as Approve or reject when inside the Action input. also if any comment are present take them.​
        actions:
            ApprovalRequest_Action: @actions.ApprovalRequest_Action
                with action = ...
                with comments = ...
                with workItemId = ...
            IdentifyObjectByName: @actions.IdentifyObjectByName
                with objectName = ...
            IdentifyRecordByName: @actions.IdentifyRecordByName
                with recordName = ...
                with objectApiName = ...
            QueryRecords: @actions.QueryRecords
                with query = ...
                with customizationInstructions = ...
            ProcessInstanceWorkItem_Id_Action: @actions.ProcessInstanceWorkItem_Id_Action
                with recordId = ...
    actions:
        IdentifyObjectByName:
            description: |
                Finds the Salesforce object API name by extracting an object name from the user input.
            label: "Identify Object by Name"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "EmployeeCopilot__IdentifyObjectByName"
            target: "standardInvocableAction://identifyObject"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            inputs:
                "objectName": string
                    description: |
                      Term representing a salesforce object name from which we want to retrieve the matching api names. For instance for the query "list the reports from user Marc", IdentifyObjectByName could be called 2 times, with objectName="reports" and objectName="user".
                    label: "objectName"
                    is_required: True
                    is_user_input: False
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            outputs:
                "objectApiNames": list[object]
                    description: |
                      A list of the matching API names of Salesforce object types.
                    label: "objectApiNames"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "lightning__textType"
        IdentifyRecordByName:
            description: |
                Searches for Salesforce CRM records by name and returns a list of matching Salesforce CRM record IDs.
            label: "Identify Record by Name"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "EmployeeCopilot__IdentifyRecordByName"
            target: "standardInvocableAction://identifyRecordByName"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            inputs:
                "recordName": string
                    description: |
                      The name or title of the Salesforce record extracted from user input. The name can be used to find a Salesforce CRM record.
                    label: "recordName"
                    is_required: True
                    is_user_input: True
                "objectApiName": string
                    description: |
                      The API name of the Salesforce object (such as Account or Opportunity) associated with the record the user wants to find. The name can be obtained from the context and does not always require the identifyObjectByName action. (eg. IdentifyRecordByName(recordName="Paul", objectApiName="user")). Leave empty to check with all possible objectApiNames. Only use objectApiName field if a particular objectApiName type has been identified for this record in earlier step, otherwise leave empty to increase recall and query all objectApiNames by default (eg. IdentifyRecordByName(recordName="Paul")).
                    label: "objectApiName"
                    is_required: False
                    is_user_input: False
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            outputs:
                "searchResults": list[object]
                    description: |
                      A list of the matching Salesforce record ids in descending order of relevance.
                    label: "searchResults"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "lightning__recordInfoType"
        QueryRecords:
            description: |
                Finds and retrieves Salesforce CRM records based on user input and specific conditions, such as field values. This action automatically identifies the correct records and object type. e.g. 'Find all open opportunities created in the last 5 days sorted by created date.'
            label: "Query Records"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "EmployeeCopilot__QueryRecords"
            target: "standardInvocableAction://queryRecords"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            inputs:
                "query": string
                    description: |
                      The question or request from the user's input. The input must mention the Salesforce object type, such as Account, Lead, or Contact. Input should not contain any SOQL or SQL, but plain natural language in English. Do not generate SQL or SOQL.
                    label: "query"
                    is_required: True
                    is_user_input: True
                "customizationInstructions": string
                    description: |
                      Custom instructions for the action from the user's input to optimize the query.
                    label: "customizationInstructions"
                    is_required: False
                    is_user_input: False
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
            outputs:
                "result": list[object]
                    description: |
                      A list of matching Salesforce CRM records with details about each record.
                    label: "result"
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "lightning__recordInfoType"
        ApprovalRequest_Action:
            label: "ApprovalRequest Action"
            description: "Approves a pending ProcessInstanceWorkItem (approval request). The action succeeds only if the specified approver has permission to approve the request."
            target: "apex://approveRequestInvocableAction"
            inputs:
                action: string
                    label: "action"
                    description: "This takes the input in text form 'Approve' or 'reject'. as per the User intention take appropriate word here."
                    is_required: True
                    complex_data_type_name: "lightning__textType"
                comments: string
                    label: "comments"
                    description: "If user provide the Reason for approval note it for this input"
                    is_required: False
                    complex_data_type_name: "lightning__textType"
                workItemId: string
                    label: "workItemId"
                    description: "This is the ProcessInstanceWorkItem ID that is being approved"
                    is_required: True
                    complex_data_type_name: "lightning__textType"
            outputs:
                message: string
                    label: "message"
                    description: "The output of the Outcome for Approval Request being made."
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
                newStatus: string
                    label: "newStatus"
                    description: "What status it is ProcessInstanceWorkItem in currently."
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
                success: boolean
                    label: "success"
                    description: "Approval or Disapproval Success Message"
                    complex_data_type_name: "lightning__booleanType"
                    is_displayable: False
                    filter_from_agent: False
            include_in_progress_indicator: False
            progress_indicator_message: ""
        ProcessInstanceWorkItem_Id_Action:
            label: "ProcessInstanceWorkItem Id Action"
            description: "Gets the Object ProcessInstanceWorkItem"
            target: "apex://getApprovalWorkItemInvocable"
            inputs:
                recordId: id
                    label: "recordId"
                    description: "gets the Object recordId"
                    is_required: True
                    complex_data_type_name: "lightning__recordIdType"
            outputs:
                message: string
                    label: "message"
                    description: "Gives the Success message related to it"
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
                success: boolean
                    label: "success"
                    description: "output message"
                    complex_data_type_name: "lightning__booleanType"
                    is_displayable: False
                    filter_from_agent: False
                workItemId: string
                    label: "workItemId"
                    description: "Gives the WorkItem Id for Which Approval is to be made"
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
